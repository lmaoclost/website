{
  "ci": {
    "collect": {
      "staticDistDir": "dist",
      "url": [
        "http://localhost/index.html",
        "http://localhost/about/index.html",
        "http://localhost/design/index.html",
        "http://localhost/projects/index.html"
      ],
      "numberOfRuns": 1
    },
    "assert": {
      "assertions": {
        "categories:performance": [
          "error",
          {
            "minScore": 0.95
          }
        ],
        "categories:accessibility": [
          "error",
          {
            "minScore": 0.95
          }
        ],
        "categories:best-practices": [
          "error",
          {
            "minScore": 0.9
          }
        ],
        "categories:seo": [
          "error",
          {
            "minScore": 0.9
          }
        ],
        "resource-summary:script:size": [
          "warn",
          {
            "maxNumericValue": 50000
          }
        ],
        "resource-summary:font:size": [
          "warn",
          {
            "maxNumericValue": 250000
          }
        ]
      }
    }
  }
}
