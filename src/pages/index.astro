---
import Layout from "../layouts/Layout.astro";
import PostItem from "../components/PostItem.astro";
import MonthNav from "../components/MonthNav.astro";
import { getMonths } from "../utils/blog";

const meses = await getMonths();
---

<Layout title="Blog" preloadSerif>
  <div class="mx-auto max-w-6xl px-4 py-10 flex gap-16 items-start">
    <main class="flex-1 min-w-0">
      <h1 class="text-3xl font-bold">Blog</h1>
      {meses.map((m) => (
        <section class="mt-8">
          <h2
            id={m.id}
            class="text-2xl font-bold pt-4 pb-2 border-b border-border scroll-mt-24"
          >
            {m.label}
          </h2>
          {m.posts.map((post) => (
            <PostItem post={post} />
          ))}
        </section>
      ))}
    </main>
    <MonthNav meses={meses} />
  </div>
</Layout>
