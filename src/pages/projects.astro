---
import Layout from "../layouts/Layout.astro";
import ProjectMock from "../components/ProjectMock.astro";
import { profile } from "../data/profile";
---

<Layout title="Projetos">
  <div class="mx-auto max-w-6xl px-4 pt-2 pb-8">
    <h1 class="font-mono uppercase tracking-[0.2em] text-xs font-semibold text-muted-foreground mt-10 mb-10">
      Projetos
    </h1>

    <main>
      {profile.projetos.map((pr) => (
        <article class="mb-20">
          <div class="grid grid-cols-1 md:grid-cols-[400px_minmax(0,1fr)] gap-x-11 gap-y-6 items-stretch">
            <ProjectMock tipo={pr.mock} />
            <div class="flex flex-col justify-between py-0.5 min-w-0">
              <div>
                <h2 class="font-bold text-[21px] leading-[1.25] tracking-[0.03em] uppercase mb-2.5">
                  {pr.nome}
                </h2>
                <p class="text-[17px] leading-[1.6] max-w-[520px]">
                  {pr.descricao}
                </p>
              </div>
              <div class="flex gap-5 font-mono text-sm mt-6 md:mt-0">
                <a
                  href={pr.github}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="text-foreground underline underline-offset-[3px] hover:text-primary"
                >
                  GitHub →
                </a>
                {pr.website && (
                  <a
                    href={pr.website}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="text-foreground underline underline-offset-[3px] hover:text-primary"
                  >
                    Website →
                  </a>
                )}
              </div>
            </div>
          </div>
          <hr class="border-0 border-t border-border mt-[30px] mb-6" />
          <p class="font-mono uppercase tracking-[0.18em] text-[11px] font-semibold text-muted-foreground mb-1.5">
            Tecnologias
          </p>
          <p class="font-mono text-sm leading-[1.6]">{pr.stack.join(" · ")}</p>
        </article>
      ))}
    </main>
  </div>
</Layout>
