---
// Fixed footer on every page (wired in the Layout).
// RSS and About point to routes that do not exist yet (#23
// and a future issue for the RSS feed): intentional placeholders.
---

<footer class="border-t border-border text-xs text-muted-foreground">
  <div class="mx-auto max-w-6xl flex flex-wrap items-center justify-between gap-3 px-4 pt-[18px] pb-8">
    <a
      href="/"
      class="text-sm font-bold tracking-[0.14em] text-foreground select-none hover:text-foreground"
    >
      RENAN
    </a>
    <nav aria-label="Links do rodapé" class="flex items-center gap-5">
      <a href="/rss.xml" class="hover:text-foreground">
        RSS
      </a>
      <a
        href="https://github.com/lmaoclost"
        target="_blank"
        rel="noopener noreferrer"
        class="hover:text-foreground"
      >
        GitHub
      </a>
      <a href="/about" class="hover:text-foreground">
        About
      </a>
      <span aria-hidden="true">·</span>
      <a href="/design" class="hover:text-foreground">
        Design
      </a>
    </nav>
  </div>
</footer>
