---
// Fixed nav on every page (same rule as Navbar).
const itens = [
  { nome: "Projects", href: "/projects" },
  { nome: "About", href: "/about" },
];
---

<div class="lg:hidden" id="mobile-menu" hidden>
  <nav
    aria-label="Menu de navegação mobile"
    class="border-b border-border bg-background/95 backdrop-blur-sm"
  >
    <div class="mx-auto max-w-6xl px-4 py-3 flex flex-col gap-1">
      {itens.map((it) => (
        <a
          href={it.href}
          class="rounded-md px-3 py-2 text-sm text-muted-foreground hover:bg-accent hover:text-accent-foreground"
          data-mobile-nav-link
        >
          {it.nome}
        </a>
      ))}
    </div>
  </nav>
</div>

<script is:inline>
  (function () {
    var menu = document.getElementById("mobile-menu");
    var btn = document.getElementById("mobile-menu-btn");
    if (!menu || !btn) return;
    function setOpen(open) {
      menu.hidden = !open;
      btn.setAttribute("aria-expanded", String(open));
    }
    btn.addEventListener("click", function (e) {
      e.stopPropagation();
      setOpen(menu.hidden);
    });
    document.addEventListener("click", function (e) {
      if (!menu.hidden && !menu.contains(e.target) && e.target !== btn) {
        setOpen(false);
      }
    });
    document.addEventListener("keydown", function (e) {
      if (e.key === "Escape") setOpen(false);
    });
    menu.querySelectorAll("[data-mobile-nav-link]").forEach(function (a) {
      a.addEventListener("click", function () {
        setOpen(false);
      });
    });
  })();
</script>
