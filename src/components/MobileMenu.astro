---
const itens = [
  { nome: "Blog", href: "/blog", prefixo: "/blog" },
  { nome: "Projects", href: "/projects", prefixo: "/projects" },
  { nome: "About", href: "/about", prefixo: "/about" },
];

const pathname = Astro.url.pathname;

// No wireframe, a home não se linka (home É o blog) e cada página
// oculta o item da própria rota. A home (/ e /index) não casa prefixo
// nenhum, então todos os itens aparecem lá — exceto quando o prefixo
// corresponder à rota atual.
const visiveis = itens.filter((it) => {
  if (it.prefixo === "/") return true;
  return pathname === "/" || !pathname.startsWith(it.prefixo);
});
---

<div class="lg:hidden" id="mobile-menu" hidden>
  <nav
    aria-label="Menu de navegação mobile"
    class="border-b border-border bg-background/95 backdrop-blur-sm"
  >
    <div class="mx-auto max-w-6xl px-4 py-3 flex flex-col gap-1">
      {visiveis.map((it) => (
        <a
          href={it.href}
          class="rounded-md px-3 py-2 text-sm text-muted-foreground hover:bg-accent hover:text-accent-foreground"
          data-mobile-nav-link
        >
          {it.nome}
        </a>
      ))}
      <button
        type="button"
        class="mt-1 rounded-md px-3 py-2 text-left text-sm text-muted-foreground hover:bg-accent hover:text-accent-foreground"
        onclick="document.getElementById('navbar-theme-toggle').click()"
      >
        Alternar tema
      </button>
    </div>
  </nav>
</div>

<script is:inline>
  (function () {
    var menu = document.getElementById("mobile-menu");
    var btn = document.getElementById("mobile-menu-btn");
    if (!menu || !btn) return;
    function setOpen(open) {
      menu.hidden = !open;
      btn.setAttribute("aria-expanded", String(open));
    }
    btn.addEventListener("click", function (e) {
      e.stopPropagation();
      setOpen(menu.hidden);
    });
    document.addEventListener("click", function (e) {
      if (!menu.hidden && !menu.contains(e.target) && e.target !== btn) {
        setOpen(false);
      }
    });
    document.addEventListener("keydown", function (e) {
      if (e.key === "Escape") setOpen(false);
    });
    menu.querySelectorAll("[data-mobile-nav-link]").forEach(function (a) {
      a.addEventListener("click", function () {
        setOpen(false);
      });
    });
  })();
</script>
