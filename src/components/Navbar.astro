---
import MobileMenu from "./MobileMenu.astro";

const pathname = Astro.url.pathname;

const itens = [
  { nome: "Projects", href: "/projects", prefixo: "/projects" },
  { nome: "About", href: "/about", prefixo: "/about" },
];

// O blog é a própria home e o brand "RENAN" já volta pra ela, então
// "Blog" não é item de nav. O item da rota atual também não se linka
// (ex: /about não mostra "About").
const visiveis = itens.filter((it) => !pathname.startsWith(it.prefixo));
---

<header class="sticky top-0 z-50 border-b border-border bg-background/80 backdrop-blur-sm">
  <nav
    aria-label="Navegação principal"
    class="mx-auto flex h-14 max-w-6xl items-center justify-between px-4"
  >
    <div class="flex items-center gap-7">
      <a
        href="/"
        class="text-sm font-bold tracking-[0.14em] text-foreground select-none hover:text-foreground"
      >
        RENAN
      </a>
      <div class="hidden md:flex items-center gap-6">
        {visiveis.map((it) => (
          <a
            href={it.href}
            class="text-sm text-muted-foreground hover:text-foreground"
          >
            {it.nome}
          </a>
        ))}
      </div>
    </div>

    <div class="flex items-center gap-2">
      <button
        type="button"
        aria-label="Buscar"
        title="Buscar (em breve)"
        class="rounded border border-border px-2.5 py-1 text-sm text-muted-foreground cursor-not-allowed opacity-70"
        disabled
      >
        ⌘K
      </button>
      <button
        type="button"
        id="navbar-theme-toggle"
        aria-label="Alternar tema"
        class="rounded px-2.5 py-1 text-sm text-muted-foreground hover:bg-accent hover:text-accent-foreground"
        onclick="toggleTheme()"
      >
        ◐
      </button>
      <button
        type="button"
        id="mobile-menu-btn"
        aria-label="Menu"
        aria-expanded="false"
        aria-controls="mobile-menu"
        class="md:hidden rounded px-2.5 py-1 text-sm text-muted-foreground hover:bg-accent hover:text-accent-foreground"
      >
        ☰
      </button>
    </div>
  </nav>
</header>

<MobileMenu client:load itens={visiveis} />
