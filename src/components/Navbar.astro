---
import MobileMenu from "./MobileMenu.astro";
import GithubIcon from "./icons/GithubIcon.astro";
import LinkedinIcon from "./icons/LinkedinIcon.astro";
import SunIcon from "./icons/SunIcon.astro";
import MoonIcon from "./icons/MoonIcon.astro";

const itens = [
  { nome: "Projects", href: "/projects" },
  { nome: "About", href: "/about" },
];
---

<header
  class="sticky top-0 z-50 border-b border-border bg-background/80 backdrop-blur-sm"
>
  <nav aria-label="Navegação principal" class="mx-auto max-w-6xl">
    <div class="flex h-14 items-center justify-between px-4">
      <div class="flex items-center gap-7">
        <a
          href="/"
          class="text-sm font-bold tracking-[0.14em] text-foreground select-none hover:text-foreground"
        >
          RENAN
        </a>
        <div class="hidden md:flex items-center gap-6">
          {
            itens.map((it) => (
              <a
                href={it.href}
                class="text-sm text-muted-foreground hover:text-foreground"
              >
                {it.nome}
              </a>
            ))
          }
        </div>
      </div>

      <div class="flex items-center gap-2">
        <a
          href="https://github.com/lmaoclost"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="GitHub"
          class="flex rounded p-1.5 text-muted-foreground hover:text-foreground hover:bg-accent"
        >
          <GithubIcon />
        </a>
        <a
          href="https://www.linkedin.com/in/renansmoliveira/"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="LinkedIn"
          class="flex rounded p-1.5 text-muted-foreground hover:text-foreground hover:bg-accent"
        >
          <LinkedinIcon />
        </a>
        <button
          type="button"
          id="navbar-theme-toggle"
          aria-label="Alternar tema"
          class="rounded p-1.5 text-muted-foreground hover:text-foreground hover:bg-accent"
          onclick="toggleTheme()"
        >
          <span class="dark:hidden flex">
            <SunIcon />
          </span>
          <span class="hidden dark:flex">
            <MoonIcon />
          </span>
        </button>
        <button
          type="button"
          id="mobile-menu-btn"
          aria-label="Menu"
          aria-expanded="false"
          aria-controls="mobile-menu"
          class="md:hidden rounded p-1.5 text-muted-foreground hover:text-foreground hover:bg-accent"
        >
          ☰
        </button>
      </div>
    </div>
  </nav>
</header>

<MobileMenu client:load itens={itens} />
